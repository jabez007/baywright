{
  "name": "baywright",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm test && npm run build && npm run test:e2e && npm audit && npm audit --omit=dev && git diff --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.10"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "pinia": "^4.0.3",
    "three": "^0.186.1",
    "vue": "^3.5.43",
    "vue-router": "^5.2.0"
  }
}
